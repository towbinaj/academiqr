# ── Security Headers ──
<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # HSTS: browsers use HTTPS only for 1 year. No includeSubDomains (cPanel/webmail
  # subdomains have their own certs). Keep the SSL cert renewed: with HSTS an
  # expired cert can't be clicked through.
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
</IfModule>

# ── Force HTTPS ──
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Social + search crawlers on short URLs -> og.php (server-rendered OG preview tags)
  RewriteCond %{HTTP_USER_AGENT} facebookexternalhit|Twitterbot|LinkedInBot|Slackbot|Discordbot|WhatsApp|TelegramBot|Googlebot|bingbot|DuckDuckBot|YandexBot|Baiduspider [NC]
  RewriteRule ^u/([^/]+)/([^/]+)/?$ /og.php [L,QSA]

  # Short URLs: /u/{username}/{slug} -> public.html (public.js resolves from the path)
  RewriteRule ^u/([^/]+)/([^/]+)/?$ /public.html [L,QSA]

  # Anything that isn't a real file or directory -> 404.php (custom page, real 404 status).
  # ErrorDocument below is ignored by this host, so don't rely on it.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /404.php [L]
</IfModule>

# ── Cache Control ──
<IfModule mod_expires.c>
  ExpiresActive On
  # CSS/JS with hashed filenames — cache aggressively
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  # Apache serves .js as text/javascript, which the line above never matched (JS was uncached)
  ExpiresByType text/javascript "access plus 1 year"
  # Images
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  # Self-hosted fonts (content-hashed filenames)
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  # HTML — don't cache (so updates are seen immediately)
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ── Custom 404 page ──
ErrorDocument 404 /404.html

# ── Prevent directory listing ──
Options -Indexes

# ── Block access to sensitive files ──
<FilesMatch "\.(env|gitignore|md|json|lock)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

# Re-allow the web app manifest (linked from every page); later sections win,
# so this overrides the .json block above for this one file only.
<Files "manifest.json">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
</Files>
